# ==========================================
# KONFIGURACJA GEMINI TTRPG MASTER
# ==========================================

# Klucz API z Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=twoj_klucz_api_gemini_tutaj

# Najnowocześniejszy model Gemini z funkcją myślenia
GEMINI_MODEL=gemini-3.8-flash

# Model generowania obrazów na żądanie
IMAGEN_MODEL=imagen-3.0-generate-002

# Hasło dostępu do pokoju gry dla znajomych
ROOM_PASSWORD=dragon2026

# Osobny PIN Mistrza Gry do operacji administracyjnych (nie udostępniaj graczom)
GM_PIN=zmien_na_wlasny_pin

# Konfiguracja serwera i bazy danych
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./ttrpg_game.db
SECRET_KEY=zmien_ten_klucz_na_losowy_ciag_znakow_w_produkcji

# Web Push (bez Firebase). Wygeneruj parę VAPID i zachowaj ją na stałe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
